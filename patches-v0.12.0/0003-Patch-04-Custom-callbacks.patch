diff --git a/src/agent.c b/src/agent.c
index bb1669c3..33322d28 100644
--- a/src/agent.c
+++ b/src/agent.c
@@ -213,6 +213,18 @@ int ssh_set_agent_socket(ssh_session session, socket_t fd)
     return ssh_socket_set_fd(session->agent->sock, fd);
 }
 
+int ssh_set_agent_callback(ssh_session session, ssh_agent_callback cb, void *userdata) {
+  if (!session || !cb)
+    return SSH_ERROR;
+  if (!session->agent){
+    ssh_set_error(session, SSH_REQUEST_DENIED, "Session has no active agent");
+    return SSH_ERROR;
+  }
+  session->agent->callback = cb;
+  session->agent->userdata = userdata;
+  return 0;
+}
+
 /**
  * @}
  */
@@ -298,6 +310,15 @@ static int agent_talk(struct ssh_session_struct *session,
     SSH_LOG(SSH_LOG_TRACE, "Request length: %" PRIu32, len);
     PUSH_BE_U32(payload, 0, len);
 
+    if (session->agent->callback != NULL) {
+      len = session->agent->callback(ssh_buffer_get(request), len, reply, session->agent->userdata);
+      if (len <= 0) {
+        SSH_LOG(SSH_LOG_WARN, "Error calling agent");
+        return -1;
+      }
+      return 0;
+    }
+
     /* send length and then the request packet */
     if (atomicio(session->agent, payload, 4, 0) == 4) {
         if (atomicio(session->agent, ssh_buffer_get(request), len, 0) != len) {
@@ -500,7 +521,9 @@ int ssh_agent_is_running(ssh_session session)
         return 0;
     }
 
-    if (ssh_socket_is_open(session->agent->sock)) {
+    if (session->agent->callback != NULL) {
+        return 1;
+    } else if (ssh_socket_is_open(session->agent->sock)) {
         return 1;
     } else {
         if (agent_connect(session) < 0) {
