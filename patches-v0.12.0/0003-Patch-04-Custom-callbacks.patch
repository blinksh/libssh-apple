+  ssh_agent_callback callback;
+  void *userdata;
 };
 
 /* agent.c */
@@ -120,6 +122,7 @@ ssh_string ssh_agent_sign_data(ssh_session session,
                                struct ssh_buffer_struct *data);
 
 #ifdef __cplusplus
+
