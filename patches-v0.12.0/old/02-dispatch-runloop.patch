-    switch (state) {
-    case SSH_KNOWN_HOSTS_OK:
-        break; /* ok */
-    default:
-        SSH_LOG(SSH_LOG_WARN, "Couldn't verify knownhost during proxyjump.");
-        return SSH_ERROR;
