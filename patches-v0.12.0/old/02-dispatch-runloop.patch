-    rc = digest(ssh_string_data(blob), ssh_string_len(blob), h);
-    if (rc != SSH_OK) {
-        free(h);
-        goto out;
-    }
-
-    *hash = h;
-    ret = SSH_OK;
-
-out:
-    SSH_STRING_FREE(blob);
-    return ret;
-}
