                 session->opts.ProxyCommand);
-#else
-        ssh_set_error(session,
-                      SSH_FATAL,
-                      "The libssh is built without support for proxy commands.");
-        ret = SSH_ERROR;
-#endif /* WITH_EXEC */
     } else {
         ret = ssh_socket_connect(session->socket,
                                  session->opts.host,
diff --git a/src/misc.c b/src/misc.c
