 /**
  * @internal
  * @brief Open a socket on a ProxyCommand
@@ -1599,15 +1602,15 @@ int ssh_socket_connect(ssh_socket s,
  * @param command Command to execute.
  * @returns `SSH_OK` socket is being connected.
  * @returns `SSH_ERROR` error while executing the command.
+ *
+ * Under WITH_EXEC=OFF (Blink/dispatch build) execution is delegated to
+ * the set_proxycommand_function callback; if no callback is registered
+ * the call fails cleanly instead of falling through to fork/exec.
  */
-
-__thread void (*thread_ssh_execute_command)(const char *command, socket_t in, socket_t out) = NULL;
-
 int
 ssh_socket_connect_proxycommand(ssh_session session, ssh_socket s, const char *command)
 {
     socket_t pair[2];
-    int pid;
     int rc;
 
     if (s->state != SSH_SOCKET_NONE) {
@@ -1623,13 +1626,24 @@ int ssh_socket_connect(ssh_socket s,
     if (session->common.callbacks && ssh_callbacks_exists(session->common.callbacks, set_proxycommand_function)) {
         session->common.callbacks->set_proxycommand_function(command, pair[0], pair[0],
                                                              session->common.callbacks->userdata);
+#ifdef WITH_EXEC
     } else if (thread_ssh_execute_command != NULL) {
         (*thread_ssh_execute_command)(command, pair[0], pair[0]);
     } else {
-        pid = 0; /* BLINK fork(); */
+        int pid = fork();
