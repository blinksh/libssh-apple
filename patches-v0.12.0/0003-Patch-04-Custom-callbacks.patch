From 180edcdea2dda16684910e7211c2a9c11d920d81 Mon Sep 17 00:00:00 2001
From: Carlos Cabanero <carlos@blink.sh>
Date: Sat, 11 Apr 2026 15:31:30 -0400
Subject: [PATCH] Patch 04: Custom callbacks

- callbacks.h: forward channel open, proxycommand, session exception typedefs
  and fields in ssh_callbacks_struct; thread_ssh_execute_command extern
- libssh.h: ssh_agent_callback typedef, ssh_set_agent_callback declaration
- agent.h: callback/userdata fields in ssh_agent_struct
- agent.c: ssh_set_agent_callback(), callback path in agent_talk(),
  callback check in ssh_agent_is_running()
- client.c: session_exception_function invocation on error,
  proxycommand call updated with session param
- messages.c: channel_open_request_forward_function handler
---
 include/libssh/agent.h     |  3 +++
 include/libssh/callbacks.h | 11 +++++++++++
 include/libssh/libssh.h    |  3 +++
 include/libssh/socket.h    |  2 +-
 src/agent.c                | 25 ++++++++++++++++++++++++-
 src/client.c               | 16 ++++++++--------
 src/misc.c                 |  9 +++++++--
 src/socket.m               | 27 ++++++++++++++++++++-------
 8 files changed, 77 insertions(+), 19 deletions(-)

diff --git a/include/libssh/agent.h b/include/libssh/agent.h
