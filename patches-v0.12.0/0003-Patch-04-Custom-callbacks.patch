+        close(pair[0]);
+        close(pair[1]);
+        return SSH_ERROR;
+#endif /* WITH_EXEC */
     }
 #ifndef HAVE_DISPATCH_H
     close(pair[0]);
@@ -1663,7 +1677,6 @@ int ssh_socket_connect(ssh_socket s,
 
