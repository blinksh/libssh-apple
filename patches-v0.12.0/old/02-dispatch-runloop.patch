-    rc = socketpair(PF_UNIX, SOCK_STREAM, 0, pair);
-    if (rc == -1) {
-        ssh_set_error(session,
-                      SSH_FATAL,
-                      "Creating socket pair failed: %s",
-                      ssh_strerror(errno, err_msg, SSH_ERRNO_MSG_MAX));
-        goto fail;
-    }
